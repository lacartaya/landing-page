{
  "name": "luis-cartaya",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:legal": "node scripts/prelaunch.mjs",
    "build:release": "node scripts/prelaunch.mjs && tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "deploy": "cf deploy --prebuilt",
    "build:develop": "tsc --noEmit && vite build --mode develop"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.7",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cf": "1.0.0-beta.26",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.7"
  },
  "packageManager": "pnpm@11.2.0"
